<?xml version="1.0" encoding="utf-8"?>
<!-- Plex servers on the home network are often reached over plain http (e.g. 192.168.x.x:32400). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
